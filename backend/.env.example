# ============================================
# CaptchaMaster AI Trainer — Backend Config
# Copy this file to .env and fill your values:
#   cp .env.example .env
# ============================================

# App
APP_NAME=CaptchaMaster AI Trainer
APP_SHORT_NAME=CM Trainer
APP_CODE_NAME=CM-AI
APP_VERSION=3.0.0
DEBUG=true

# MongoDB (local OR Atlas)
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/captchamaster
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=captchamaster

# Google OAuth (optional — Google sign-in)
GOOGLE_CLIENT_ID=

# Super Admin (auto-created on first run)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=superadmin123

# JWT — production e strong random key dite hobe
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Model
MODEL_PATH=backend/model/best.pt

# Training
TRAINING_SCRIPT_PATH=backend/training/train_model.py
PROGRESS_FILE_PATH=runs/train_progress.txt
TRAINING_QUEUE_DIR=training_queue

# Upload
UPLOAD_DIR=uploads
TRAINING_DATA_DIR=training_data

# Dataset / Logs / Exports
DATASET_DIR=dataset
LOGS_DIR=logs
EXPORTS_DIR=exports

# ============================================
# Cloudflare R2 Storage (optional)
# Settings UI thekeo fill kora jay (MongoDB te save hoy)
# ============================================
R2_ENABLED=false
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=captchamaster
R2_REGION=auto

# Security
RATE_LIMIT_PER_MINUTE=300
MAX_UPLOAD_SIZE_MB=50
